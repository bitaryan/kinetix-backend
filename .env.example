# Copy this file to .env and replace all development values before deployment.
APP_NAME=GPSS Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=jdbc:postgresql://localhost:5432/gpss

# Generate a unique production value with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-64-character-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=gpss-backend
JWT_AUDIENCE=gpss-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set true only when the API is served over HTTPS. Required when APP_ENV=production.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
# Comma-separated origins. Do not use * when cookies are enabled.
# Production requires https:// origins (no localhost).
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Per-IP auth throttles (set 0 to disable). Defaults support ~100 staff behind one NAT.
LOGIN_RATE_LIMIT_PER_MINUTE=120
REFRESH_RATE_LIMIT_PER_MINUTE=300
# Per-user GPS ping throttle (continuous mode typically sends every 30–60s).
LOCATION_PING_RATE_LIMIT_PER_MINUTE=120
# Ignore GPS samples closer than this many seconds (protects DB under bursty clients).
LOCATION_PING_MIN_INTERVAL_SECONDS=5
# Max stored pings per punch session (~8h @ 5s interval with catch-up headroom).
LOCATION_PING_MAX_PER_SESSION=6000
# Max offline-queued pings the app may flush in one batch request.
LOCATION_PING_BATCH_MAX=120
# Comma-separated proxy IPs allowed to supply X-Forwarded-For (leave empty locally).
TRUSTED_PROXY_IPS=

# Async DB pool for concurrent login / punch / location traffic (~100 users).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30

# Punch-in / client-log verification image storage (relative or absolute path).
UPLOAD_DIR=uploads
# Max size per image in bytes (default 5 MiB).
MAX_UPLOAD_BYTES=5242880
# Optional absolute origin for selfie URLs (e.g. https://api.gpss.com). Empty = /uploads/...
PUBLIC_BASE_URL=
