{
  "title": "GPSS Operations",
  "uid": "gpss-operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [{"name": "datasource", "type": "datasource", "query": "prometheus"}]},
  "panels": [
    {"id": 1, "title": "Requests by status", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sum by (status) (rate(gpss_http_requests_total[5m]))", "legendFormat": "{{status}}"}]},
    {"id": 2, "title": "p95 latency by route (seconds)", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (route, le) (rate(gpss_http_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}"}]},
    {"id": 3, "title": "Rate limited requests", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sum by (route) (rate(gpss_http_requests_total{status=\"429\"}[5m]))", "legendFormat": "{{route}}"}]},
    {"id": 4, "title": "WebSocket connections", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "gpss_websocket_connections", "legendFormat": "{{instance}}"}]},
    {"id": 5, "title": "Pending deliveries", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "max(gpss_delivery_pending)"}]},
    {"id": 6, "title": "Oldest delivery age (seconds)", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "max(gpss_delivery_oldest_seconds)"}]}
  ]
}
